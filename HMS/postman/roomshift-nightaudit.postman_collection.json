      "name": "1. Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Token exists in response\", function () { pm.expect(json.token).to.not.be.undefined; });",
                  "pm.collectionVariables.set('token', json.token || '');"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Run this first. Uses an admin account because property/unit/room creation is admin-only."
          },
          "response": []
        },
        {
          "name": "Seed Dynamic Variables",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function fmt(d) { return d.toISOString().slice(0, 10); }",
                  "const now = new Date();",
                  "const today = new Date(now);",
                  "const tomorrow = new Date(now); tomorrow.setDate(tomorrow.getDate() + 1);",
                  "const checkout = new Date(now); checkout.setDate(checkout.getDate() + 4);",
                  "const past = new Date(now); past.setDate(past.getDate() - 1);",
                  "const suffix = `${Date.now()}${Math.floor(Math.random() * 1000)}`;",
                  "pm.collectionVariables.set('seedSuffix', suffix);",
                  "pm.collectionVariables.set('today', fmt(today));",
                  "pm.collectionVariables.set('tomorrow', fmt(tomorrow));",
                  "pm.collectionVariables.set('checkoutDate', fmt(checkout));",
                  "pm.collectionVariables.set('auditDate', fmt(today));",
                  "pm.collectionVariables.set('pastDate', fmt(past));",
                  "pm.collectionVariables.set('propertyName', `Room Shift Lab ${suffix}`);",
                  "pm.collectionVariables.set('propertyCode', `RSL${suffix.slice(-5)}`);",
                  "const randId = () => Math.random().toString(36).substring(2, 10).toUpperCase();",
                  "const randPhone = () => '+91-9' + Math.floor(100000000 + Math.random() * 900000000);",
                  "pm.collectionVariables.set('phone1', randPhone());",
                  "pm.collectionVariables.set('phone2', randPhone());",
                  "pm.collectionVariables.set('phone3', randPhone());",
                  "pm.collectionVariables.set('phone4', randPhone());",
                  "pm.collectionVariables.set('phone5', randPhone());",
                  "pm.collectionVariables.set('id1', randId());",
                  "pm.collectionVariables.set('id2', randId());",
                  "pm.collectionVariables.set('id3', randId());",
                  "pm.collectionVariables.set('id4', randId());",
                  "pm.collectionVariables.set('id5', randId());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" },
          "response": []
        }
      ]
    },
