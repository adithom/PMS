    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.adith.os.HMS" level="INFO"/>
    <logger name="com.adith.os.HMS.billing.nightaudit" level="INFO"/>
</configuration>
