# ─── Backend ────────────────────────────────────────────────────────────────
# Database (Railway: set SPRING_DATASOURCE_URL using ${{Postgres.PGHOST}} etc.)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/HMS
SPRING_DATASOURCE_USERNAME=hms_user
SPRING_DATASOURCE_PASSWORD=hms

# JWT — generate a fresh key with: openssl rand -base64 32
JWT_SECRET=<generate with: openssl rand -base64 32>
JWT_EXPIRATION_MS=36000000

# Admin seed account (created on first startup if no users exist)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# CORS — comma-separated, no trailing slashes
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Invoice PDF storage path (use Railway Volume mounted at /data/invoices in prod)
INVOICE_STORAGE_PATH=./hms-data/invoices/

# Server port (Railway injects PORT automatically)
PORT=8080

# ─── Frontend ────────────────────────────────────────────────────────────────
# Baked into the JS bundle at build time — must be set before npm run build
VITE_API_BASE_URL=http://localhost:8080/api
